; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Beat the Little Boss"
config/description="An offline pixel desktop pet for beating the little boss."
config/icon="res://assets/icon.png"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 0)
boot_splash/show_image=false

[application_run]

max_fps=60

[display]

window/size/viewport_width=192
window/size/viewport_height=212
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/size/no_focus=true
window/size/window_width_override=1
window/size/window_height_override=1
window/subwindows/embed_subwindows=false
window/per_pixel_transparency/allowed=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
2d/snap/snap_2d_transforms_to_pixel=true
viewport/transparent_background=true
